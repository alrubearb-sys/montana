import { Palette } from "std-widgets.slint";
// Omarchy's system font, embedded so the panel looks the same on a Mac without it.
import "fonts/JetBrainsMono-Regular.ttf";

export struct Spot { label: string, height: string, sky: string, temperature: string, wind: string }
export struct Day { name: string, sky: string, temperature: string, wind: string, sun: string, snow: string }
export struct Tick { position: float, text: string }
export struct Mark { position: float, text: string, midnight: bool }
export enum Tone { line, snow, ice }
export struct Legend { text: string, tone: Tone }
export struct Choice { title: string, detail: string, editable: bool, removable: bool }
// zero: where 0 °C is, from the top, or -1 when the chart has no such line.
export struct Chart { legend: [Legend], line: string, snow: string, rain: string, ice: string, ticks: [Tick], zero: float }

// Omarchy's palette roles (themes/tokyo-night/colors.toml), so a later version can read
// the active Omarchy theme instead of these values.
global Omarchy {
    out property <color> accent: #7aa2f7;
    out property <color> muted: #414868;
    out property <color> background: #1a1b26;
    out property <color> dark-background: #13141c;
    out property <color> foreground: #a9b1d6;
    out property <color> dark-foreground: #565f89;
    out property <color> bright-foreground: #c0caf5;
    out property <color> red: #f7768e;
    out property <color> yellow: #e0af68;
    out property <color> green: #9ece6a;
    out property <color> blue: #7aa2f7;
    out property <color> bright-cyan: #0db9d7;
}

// Omarchy's type scale and spacing at the default base size of 12 (shell/Commons/Style.qml).
global Style {
    out property <length> caption: 10px;
    out property <length> body-small: 11px;
    out property <length> body: 12px;
    out property <length> title: 14px;
    out property <length> heading: 16px;
    out property <length> panel-padding: 18px;
    out property <length> row-gap: 8px;
    out property <length> label-gap: 4px;
    out property <length> control-padding-x: 10px;
    out property <length> control-padding-y: 6px;
    out property <length> control-gap: 8px;
    out property <length> control-height: 28px;
    out property <length> popup-row-height: 28px;
    out property <length> row-padding-x: 12px;
}

global Theme {
    out property <color> background: Omarchy.background;
    out property <color> chart: Omarchy.dark-background;
    out property <color> border: Omarchy.accent;
    out property <color> grid: Omarchy.muted;
    out property <color> dim: Omarchy.dark-foreground;
    out property <color> text: Omarchy.foreground;
    out property <color> temperature: Omarchy.bright-cyan;
    out property <color> wind: Omarchy.green;
    out property <color> snow: Omarchy.bright-foreground;
    out property <color> rain: Omarchy.blue;
    out property <color> sun: Omarchy.yellow;
    out property <color> error: Omarchy.red;
}

component Label inherits Text {
    color: Theme.dim;
    font-size: Style.body-small;
}

component Value inherits Text {
    color: Theme.text;
    font-size: Style.title;
}

component Separator inherits Rectangle {
    height: 1px;
    background: Theme.grid;
}

// Omarchy's [controls] chrome: a 1 px foreground border at 40 %, a faint fill, and
// stronger fills on hover and press. Corners stay square, as in Omarchy's default.
component Button inherits Rectangle {
    in property <string> text;
    callback clicked;
    background: Theme.text.with-alpha(touch.pressed ? 0.22 : touch.has-hover ? 0.08 : 0.04);
    border-width: 1px;
    border-color: Theme.text.with-alpha(touch.has-hover ? 0.25 : 0.4);
    HorizontalLayout {
        padding-left: Style.control-padding-x;
        padding-right: Style.control-padding-x;
        padding-top: Style.control-padding-y;
        padding-bottom: Style.control-padding-y;
        Text { text: root.text; color: Theme.text; font-size: Style.body; vertical-alignment: center; horizontal-alignment: center; }
    }
    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// A square control with a folded map drawn on it: the panel font has no icons.
component MapButton inherits Rectangle {
    callback clicked;
    width: Style.control-height;
    height: Style.control-height;
    background: Theme.text.with-alpha(touch.pressed ? 0.22 : touch.has-hover ? 0.08 : 0.04);
    border-width: 1px;
    border-color: Theme.text.with-alpha(touch.has-hover ? 0.25 : 0.4);
    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 14px;
        viewbox-width: 16;
        viewbox-height: 14;
        commands: "M 1 2 L 5.5 1 L 10.5 2 L 15 1 L 15 12 L 10.5 13 L 5.5 12 L 1 13 Z M 5.5 1 L 5.5 12 M 10.5 2 L 10.5 13";
        stroke: Theme.text;
        stroke-width: 1.25px;
    }
    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// Omarchy's dropdown trigger: control chrome, the current choice and a chevron.
component Picker inherits Rectangle {
    in property <string> text;
    in property <bool> open;
    callback clicked;
    height: Style.control-height;
    background: Theme.text.with-alpha(touch.pressed ? 0.22 : touch.has-hover || root.open ? 0.08 : 0.04);
    border-width: 1px;
    border-color: Theme.text.with-alpha(touch.has-hover || root.open ? 0.25 : 0.4);
    HorizontalLayout {
        padding-left: Style.control-padding-x;
        padding-right: Style.control-gap;
        spacing: Style.control-gap;
        Text { text: root.text; color: Theme.border; font-size: Style.heading; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        Path {
            width: 10px;
            height: 6px;
            y: (parent.height - self.height) / 2;
            viewbox-width: 10;
            viewbox-height: 6;
            commands: "M 1 1 L 5 5 L 9 1";
            stroke: Theme.text;
            stroke-width: 1.5px;
        }
    }
    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

component Plot inherits Rectangle {
    in property <Chart> chart;
    in property <[Mark]> marks;
    in property <color> tint;
    in property <int> hovered;
    in property <int> hours;
    in property <length> axis: 38px;
    height: 94px;

    HorizontalLayout {
        x: 0; y: 0; height: 14px; spacing: 10px;
        for part in chart.legend: Label { text: part.text; color: part.tone == Tone.snow ? Theme.snow : part.tone == Tone.ice ? Theme.error : root.tint; }
        Rectangle { }
    }

    for tick in chart.ticks: Label {
        x: 0;
        y: plot.y + plot.height * tick.position - self.height / 2;
        width: root.axis - 6px;
        horizontal-alignment: right;
        text: tick.text;
        color: chart.zero >= 0 && tick.text == "0" ? Theme.text : Theme.dim;
    }

    plot := Rectangle {
        x: root.axis;
        y: 20px;
        width: parent.width - root.axis;
        height: parent.height - 26px;
        background: Theme.chart;

        for tick in chart.ticks: Rectangle {
            y: plot.height * tick.position;
            width: 100%;
            height: 1px;
            background: Theme.grid;
        }
        // Freezing, a thin red line so the side of 0 °C shows at a glance, as in Omarchy.
        if chart.zero >= 0: Rectangle {
            y: plot.height * chart.zero;
            width: 100%;
            height: 1px;
            background: Theme.error.with-alpha(0.4);
        }
        for mark in marks: Rectangle {
            x: plot.width * mark.position;
            width: 1px;
            height: 100%;
            background: mark.midnight ? Theme.dim : Theme.grid;
        }
        if chart.rain != "": Path {
            width: 100%; height: 100%;
            viewbox-width: 370; viewbox-height: 68;
            commands: chart.rain;
            fill: Theme.rain;
        }
        if chart.snow != "": Path {
            width: 100%; height: 100%;
            viewbox-width: 370; viewbox-height: 68;
            commands: chart.snow;
            fill: Theme.snow;
        }
        if chart.ice != "": Path {
            width: 100%; height: 100%;
            viewbox-width: 370; viewbox-height: 68;
            commands: chart.ice;
            fill: Theme.error;
        }
        if chart.line != "": Path {
            width: 100%; height: 100%;
            viewbox-width: 370; viewbox-height: 68;
            commands: chart.line;
            stroke: root.tint;
            stroke-width: 2px;
        }
        if root.hovered >= 0: Rectangle {
            x: plot.width * (root.hovered + 0.5) / root.hours;
            width: 1px;
            height: 100%;
            background: Theme.text;
        }
    }
}

export component Tray inherits SystemTrayIcon {
    callback open <=> root.clicked;
    title: "";
    tooltip: "Peakcast";
    icon: Palette.color-scheme == ColorScheme.dark ? @image-url("mountain-white.svg") : @image-url("mountain-black.svg");
}

export component Panel inherits Window {
    in property <string> area;
    in property <string> daylight;
    in property <string> problem;
    in property <string> updated;
    in property <string> snow-line;
    in property <string> freezing-level;
    in property <string> snow-depth;
    in property <[Spot]> spots;
    in property <[Day]> days;
    in property <[Mark]> marks;
    in property <Chart> temperature;
    in property <Chart> wind;
    in property <Chart> precipitation;
    in property <[string]> readings;
    in property <[Choice]> choices;
    // Index in `choices` of the area on show, or -1.
    in property <int> selected;
    in property <bool> searching;
    // A newer release, or empty when this one is the newest.
    in property <string> new-version;
    callback choose(int);
    callback remove(int);
    callback move-area(int, int);
    // How many saved areas lead the list and can be dragged; 0 while it is filtered.
    in property <int> movable;
    callback edit(int);
    callback edited(string);
    callback search(string);
    callback previous;
    callback next;
    callback refresh;
    callback open-map;
    callback update;
    callback dismiss;
    callback quit;
    property <int> hours: readings.length;
    property <int> hovered: -1;
    property <bool> picking;
    property <int> cursor;

    // A saved area being dragged, as Omarchy's world clock drags its cities.
    property <int> drag-from: -1;
    property <int> drag-to: -1;
    property <length> drag-offset;
    property <bool> press-dragged;
    property <bool> dropping;
    // While the list takes its new order: the rows are reused by place, so a glide
    // then would slide the wrong row.
    property <bool> settling;

    // A row is passed once the pointer is 0.6 of a row past it, as in Omarchy, so
    // the target does not flicker at the edge between two rows.
    function drag(index: int, offset: length) {
        if root.dropping { return; }
        if root.drag-from < 0 {
            if index >= root.movable || abs(offset) < 4px { return; }
            root.drag-from = index;
            root.drag-to = index;
            root.press-dragged = true;
        }
        // It stops at the first and the last area instead of leaving the list.
        let highest = -root.drag-from * Style.popup-row-height;
        let lowest = (root.movable - 1 - root.drag-from) * Style.popup-row-height;
        root.drag-offset = max(highest, min(lowest, offset));
        let raw = root.drag-offset / Style.popup-row-height;
        let held = root.drag-to - root.drag-from;
        let next = abs(raw - held) >= 0.6 ? round(raw) : held;
        root.drag-to = max(0, min(root.movable - 1, root.drag-from + next));
    }
    // The row glides into its slot first; the new order is kept when it lands.
    function drop() {
        if root.drag-from < 0 || root.dropping { return; }
        root.dropping = true;
        root.drag-offset = (root.drag-to - root.drag-from) * Style.popup-row-height;
        landing.running = true;
    }
    function land() {
        let from = root.drag-from;
        let to = root.drag-to;
        root.settling = true;
        settled.running = true;
        root.dropping = false;
        root.drag-from = -1;
        root.drag-to = -1;
        root.drag-offset = 0;
        root.cursor = to;
        root.move-area(from, to);
    }
    settled := Timer {
        interval: 150ms;
        running: false;
        triggered => {
            self.running = false;
            root.settling = false;
        }
    }
    landing := Timer {
        interval: 120ms;
        running: false;
        triggered => {
            self.running = false;
            root.land();
        }
    }
    // The dragged row follows the pointer; the ones it passes make room for it.
    pure function shift(index: int) -> length {
        if root.drag-from < 0 { return 0; }
        if index == root.drag-from { return root.drag-offset; }
        if root.drag-from < root.drag-to && index > root.drag-from && index <= root.drag-to { return -Style.popup-row-height; }
        if root.drag-from > root.drag-to && index >= root.drag-to && index < root.drag-from { return Style.popup-row-height; }
        return 0;
    }

    function close-picker() {
        root.picking = false;
        keys.focus();
    }
    function pick(index: int) {
        root.close-picker();
        root.choose(index);
    }

    // A few times per second is enough: every redraw costs battery.
    Timer {
        interval: 66ms;
        running: pointer.has-hover;
        triggered => {
            root.hovered = min(root.hours - 1, max(0, floor((pointer.mouse-x / pointer.width) * root.hours)));
        }
    }

    title: "Peakcast";
    icon: @image-url("mountain-white.svg");
    width: 440px;
    // At least the content, so the bottom margin is never eaten.
    height: max(760px, content.preferred-height);
    no-frame: true;
    always-on-top: true;
    background: Theme.background;
    default-font-family: "JetBrains Mono";
    forward-focus: keys;

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape { root.dismiss(); return accept; }
            if event.text == Key.LeftArrow { root.previous(); return accept; }
            if event.text == Key.RightArrow { root.next(); return accept; }
            return reject;
        }
    }

    Rectangle {
        border-width: 2px;
        border-color: Theme.border;

        content := VerticalLayout {
            padding: Style.panel-padding;
            spacing: Style.row-gap;

            HorizontalLayout {
                spacing: Style.row-gap;
                trigger := Picker {
                    text: root.area;
                    open: root.picking;
                    horizontal-stretch: 1;
                    clicked => {
                        if root.picking {
                            root.close-picker();
                        } else {
                            root.cursor = -1;
                            root.edited("");
                            root.picking = true;
                        }
                    }
                }
                MapButton { clicked => { root.open-map(); } }
                Text { text: root.daylight; color: Theme.sun; font-size: Style.body; vertical-alignment: center; }
            }
            Separator { }
            if root.problem != "": Text { text: root.problem; color: Theme.error; font-size: Style.body; wrap: word-wrap; }

            for spot in root.spots: HorizontalLayout {
                VerticalLayout { width: 92px; Label { text: spot.label; } Value { text: spot.height; } }
                VerticalLayout { width: 124px; Label { text: "sky"; } Value { text: spot.sky; } }
                VerticalLayout { width: 76px; Label { text: "temp"; } Value { text: spot.temperature; color: Theme.temperature; } }
                VerticalLayout { Label { text: "wind"; } Value { text: spot.wind; color: Theme.wind; } }
            }
            HorizontalLayout {
                VerticalLayout { width: 92px; Label { text: "snow line"; } Value { text: root.snow-line; } }
                VerticalLayout { width: 124px; Label { text: "freezing level"; } Value { text: root.freezing-level; } }
                VerticalLayout { Label { text: "snow depth"; } Value { text: root.snow-depth; } }
            }
            Separator { }

            Label {
                text: root.hovered >= 0 ? root.readings[root.hovered] : "next 48 h";
                color: root.hovered >= 0 ? Theme.text : Theme.dim;
            }
            charts := Rectangle {
                height: 306px;
                Plot { y: 0; chart: root.temperature; marks: root.marks; tint: Theme.temperature; hovered: root.hovered; hours: root.hours; }
                Plot { y: 96px; chart: root.wind; marks: root.marks; tint: Theme.wind; hovered: root.hovered; hours: root.hours; }
                Plot { y: 192px; chart: root.precipitation; marks: root.marks; tint: Theme.rain; hovered: root.hovered; hours: root.hours; }
                for mark in root.marks: Label {
                    x: 38px + (parent.width - 38px) * mark.position - self.width / 2;
                    y: 288px;
                    text: mark.text;
                    color: mark.midnight ? Theme.text : Theme.dim;
                }
                pointer := TouchArea {
                    x: 38px;
                    width: parent.width - 38px;
                    height: 100%;
                    changed has-hover => { if !self.has-hover { root.hovered = -1; } }
                }
            }
            Separator { }

            HorizontalLayout {
                Label { width: 44px; text: "day"; } Label { width: 104px; text: "sky"; } Label { width: 78px; text: "temp °C"; }
                Label { width: 66px; text: "wind max"; } Label { width: 56px; text: "sun"; } Label { text: "snow"; horizontal-alignment: right; }
            }
            VerticalLayout {
                spacing: Style.label-gap;
                for day in root.days: HorizontalLayout {
                    Text { width: 44px; text: day.name; color: Theme.text; font-size: Style.body; }
                    Text { width: 104px; text: day.sky; color: Theme.text; font-size: Style.body; overflow: elide; }
                    Text { width: 78px; text: day.temperature; color: Theme.temperature; font-size: Style.body; }
                    Text { width: 66px; text: day.wind; color: Theme.wind; font-size: Style.body; }
                    Text { width: 56px; text: day.sun; color: Theme.sun; font-size: Style.body; }
                    Text { text: day.snow; color: Theme.snow; font-size: Style.body; horizontal-alignment: right; }
                }
            }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: Style.row-gap;
                Label { text: root.updated; vertical-alignment: center; horizontal-stretch: 1; }
                Button { text: "refresh"; clicked => { root.refresh(); } }
                Button { text: "quit"; clicked => { root.quit(); } }
            }
            // The sources and, when there is one, the update link: one faint line at
            // the very end, there when wanted and never in the way.
            HorizontalLayout {
                spacing: Style.row-gap;
                Label {
                    text: "Weather data by Open-Meteo (CC BY 4.0). Made with Slint.";
                    font-size: Style.caption;
                    opacity: 0.4;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
                if root.new-version != "": Label {
                    text: "Update to " + root.new-version;
                    font-size: Style.caption;
                    opacity: link.has-hover ? 0.9 : 0.4;
                    vertical-alignment: bottom;
                    link := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.update(); }
                    }
                }
            }
        }
    }

    // Above everything else; a click outside the list closes it.
    if root.picking: TouchArea {
        clicked => { root.close-picker(); }
    }
    if root.picking: Rectangle {
        x: trigger.absolute-position.x - root.absolute-position.x;
        y: trigger.absolute-position.y - root.absolute-position.y + trigger.height + Style.label-gap;
        width: trigger.width;
        height: popup.preferred-height + 4px;
        background: Theme.background;
        border-width: 2px;
        border-color: Theme.border;
        // Seen before the text field, so that it never takes these keys.
        FocusScope {
            capture-key-pressed(event) => {
                if event.text == Key.Escape { root.close-picker(); return accept; }
                // Slint gives macOS's ⌘ as control; Ctrl+arrows belong to Mission Control.
                if event.modifiers.control && event.text == Key.UpArrow {
                    if root.cursor > 0 && root.cursor < root.movable { root.move-area(root.cursor, root.cursor - 1); root.cursor -= 1; }
                    return accept;
                }
                if event.modifiers.control && event.text == Key.DownArrow {
                    if root.cursor >= 0 && root.cursor < root.movable - 1 { root.move-area(root.cursor, root.cursor + 1); root.cursor += 1; }
                    return accept;
                }
                if event.text == Key.UpArrow { root.cursor = max(-1, root.cursor - 1); return accept; }
                if event.text == Key.DownArrow { root.cursor = min(root.choices.length - 1, root.cursor + 1); return accept; }
                if event.text == Key.Return {
                    if root.cursor >= 0 { root.pick(root.cursor); } else if field.text != "" { root.search(field.text); }
                    return accept;
                }
                return reject;
            }
            popup := VerticalLayout {
                x: 2px;
                y: 2px;
                width: parent.width - 4px;
                height: self.preferred-height;
                Rectangle {
                    height: Style.popup-row-height + Style.control-padding-x;
                    if field.text == "": Text {
                        x: Style.row-padding-x;
                        height: 100%;
                        text: "Search";
                        color: Theme.dim;
                        font-size: Style.body;
                        vertical-alignment: center;
                    }
                    field := TextInput {
                        x: Style.row-padding-x;
                        width: parent.width - 2 * Style.row-padding-x;
                        height: 100%;
                        color: Theme.text;
                        font-size: Style.body;
                        vertical-alignment: center;
                        selection-background-color: Theme.text.with-alpha(0.35);
                        init => { self.focus(); }
                        edited => {
                            root.cursor = -1;
                            root.edited(self.text);
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.text.with-alpha(0.10); }
                // Each row keeps its slot in the list; what shows moves inside it, so
                // that a drag can shift it without changing the layout.
                for choice[index] in root.choices: Rectangle {
                    height: choice.detail == "" ? Style.popup-row-height : Style.popup-row-height + Style.row-padding-x;
                    z: index == root.drag-from ? 1 : 0;
                    // In the slot, which stays put: inside the moving row the pointer would
                    // be measured from a place that moves with it, and the row would shake.
                    TouchArea {
                        // Not `pointer`: inside Panel that name is the chart's touch area.
                        mouse-cursor: MouseCursor.pointer;
                        // The mouse and the keyboard share one cursor, as in Omarchy.
                        changed has-hover => { if self.has-hover && root.drag-from < 0 { root.cursor = index; } }
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down { root.press-dragged = false; }
                            if event.kind == PointerEventKind.up { root.drop(); }
                        }
                        moved => { if self.pressed { root.drag(index, self.mouse-y - self.pressed-y); } }
                        // A press that became a drag is not a pick.
                        clicked => { if !root.press-dragged { root.pick(index); } }
                    }
                    Rectangle {
                        y: root.shift(index);
                        // The rows that make room glide, as in Omarchy; the dragged one
                        // follows the pointer at once, and glides only into its slot.
                        animate y {
                            duration: root.settling || (index == root.drag-from && !root.dropping) ? 0ms : 120ms;
                            easing: ease-out;
                        }
                        width: 100%;
                        height: 100%;
                        // Opaque while dragged, so the rows under it do not show through.
                        background: index == root.drag-from ? Theme.background : transparent;
                        Rectangle {
                            background: index == root.cursor || index == root.drag-from ? Theme.text.with-alpha(0.08)
                                : index == root.selected ? Theme.text.with-alpha(0.18) : transparent;
                        }
                        VerticalLayout {
                            padding-left: Style.row-padding-x;
                            padding-right: Style.row-padding-x;
                            alignment: center;
                            Text { text: choice.title; color: Theme.text; font-size: Style.body; overflow: elide; }
                            if choice.detail != "": Text { text: choice.detail; color: Theme.dim; font-size: Style.caption; overflow: elide; }
                        }
                        // A pencil drawn like the ×, to its left: the map with this area's marks.
                        if choice.editable && index == root.cursor: Rectangle {
                            x: parent.width - Style.row-padding-x - self.width - (choice.removable ? 24px : 0px);
                            y: (parent.height - self.height) / 2;
                            width: 20px;
                            height: 20px;
                            Path {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 11px;
                                height: 11px;
                                viewbox-width: 11;
                                viewbox-height: 11;
                                commands: "M 1 10 L 1.5 7.5 L 8 1 L 10 3 L 3.5 9.5 Z M 6.5 2.5 L 8.5 4.5";
                                stroke: pencil.has-hover ? Theme.text : Theme.dim;
                                stroke-width: 1.2px;
                            }
                            pencil := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => {
                                    root.close-picker();
                                    root.edit(index);
                                }
                            }
                        }
                        // The × of Omarchy's world clock, without its circle, only on the row
                        // under the cursor. The 20 px box is there to be easy to hit.
                        if choice.removable && index == root.cursor: Rectangle {
                            x: parent.width - Style.row-padding-x - self.width;
                            y: (parent.height - self.height) / 2;
                            width: 20px;
                            height: 20px;
                            Text {
                                text: "×";
                                color: cross.has-hover ? Theme.text : Theme.dim;
                                font-size: Style.title;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            cross := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => { root.remove(index); }
                            }
                        }
                    }
                }
                if root.searching || root.choices.length == 0: Rectangle {
                    height: Style.popup-row-height;
                    Text {
                        x: Style.row-padding-x;
                        width: parent.width - 2 * Style.row-padding-x;
                        height: 100%;
                        text: root.searching ? "Searching..." : field.text == "" ? "No areas" : "No matches. Press Enter to search";
                        color: Theme.dim;
                        font-size: Style.body;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }
}
